# ===== Akita server config =====
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit credentials.

# HTTP port the Node server listens on
PORT=4000

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=akita_app
DB_PASSWORD=CHANGE_ME
DB_NAME=akita_site

# --- CORS / proxy ---
# Comma-separated list of allowed origins, e.g. https://www.akitagroup.com
# Leave empty during local development to allow any origin.
ALLOWED_ORIGINS=
# Set to 1 when running behind Nginx so req.ip reflects the real client IP
TRUST_PROXY=0

# --- SMTP (enterprise mailbox) ---
# Leave SMTP_HOST empty to skip sending mail (enquiries are still stored in MySQL).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
# Sender shown on notification mails; defaults to SMTP_USER if empty
MAIL_FROM=
# Where enquiry notifications are delivered
MAIL_TO=logistics@akitagn.com
